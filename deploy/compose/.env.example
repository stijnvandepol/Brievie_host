# Optional settings for deploy/compose/docker-compose.yml. You only need this file when
# you start the stack on the command line and want to keep the settings next to it (save
# it as .env beside docker-compose.yml). In Portainer, put these in "Environment
# variables". Nothing here is a secret that Brievie makes: the keys are made on the first
# start and kept in Docker volumes.

# The name or IP address your iPhone uses for this server. Required: the example name is
# refused. A .local name needs mDNS on your network; a fixed IP address always works.
BRIEVIE_HOSTNAME=verander-mij.local

# The published ports. Synology and some other NAS systems use 80 and 443 themselves.
# The https port is part of the address in the QR code.
#BRIEVIE_HTTP_PORT=80
#BRIEVIE_HTTPS_PORT=443

# The version of the images. Change it to update; Brievie makes a back-up first and
# refuses a step back or a jump that is too large.
#BRIEVIE_VERSION=0.5.0

# Your own installation code (at least 16 characters). Empty: it is printed once in the
# log of "api".
#BRIEVIE_SETUP_TOKEN=

# Back-ups: a folder (for example /volume1/brievie-backup; owner uid 10001) or a remote
# repository, never both. Strongly advised.
#BRIEVIE_BACKUP_DIR=
#BRIEVIE_BACKUP_REPOSITORY=
#BRIEVIE_BACKUP_S3_ACCESS_KEY_ID=
#BRIEVIE_BACKUP_S3_SECRET_ACCESS_KEY=
#BRIEVIE_BACKUP_REST_USERNAME=
#BRIEVIE_BACKUP_REST_PASSWORD=

# Let Brievie prepare an empty back-up folder itself, once (never a folder that holds
# anything, never one on the same disk as the data). The nightly back-up runs at this hour.
#BRIEVIE_BACKUP_AUTO_INIT=false
#BRIEVIE_BACKUP_HOUR=2

# The scan folder ("Scanmap"): a folder where an office scanner drops PDFs, for example
# /volume1/scans/brievie, and the group that may read and write it (100: "users").
#BRIEVIE_SCAN_DIR=
#BRIEVIE_SCAN_GID=100

# Moving from a ./brievie install on the same volumes: the version that runs now.
#BRIEVIE_ADOPT_VERSION=

# Limits and sessions.
#BRIEVIE_AUDIT_RETENTION_DAYS=365
#BRIEVIE_SESSION_IDLE_DAYS=14
#BRIEVIE_SESSION_MAX_DAYS=90
#BRIEVIE_AI_AUTOPILOT_ALLOWED=true
# Two-step verification: who must use it (none, server_admins, everyone) and the days
# they get to switch it on (0-30).
#BRIEVIE_REQUIRE_SECOND_FACTOR=none
#BRIEVIE_SECOND_FACTOR_GRACE_DAYS=7
#BRIEVIE_MAX_BODY_BYTES=2621440
#BRIEVIE_MAX_UPLOAD_BYTES=33554432
#BRIEVIE_HSTS_SECONDS=0

# Reachable from outside the home network ("Van buiten bereikbaar", docs/SELFHOST.md
# section 25). Recommended: a VPN (Tailscale, WireGuard): nobody in between can read along.
# The server's own VPN name (Tailscale on this server), e.g. nas.tail1234.ts.net:
#BRIEVIE_VPN_HOSTNAME=
# The public name of your own tunnel or reverse proxy (Brievie runs no tunnel itself), e.g.
# brievie.example.nl:
#BRIEVIE_PUBLIC_HOSTNAME=
# Your own tunnel or reverse proxy: its address(es) as Brievie sees them, CIDRs separated by spaces,
# e.g. 192.168.1.5/32. Never Docker's own gateway address.
#BRIEVIE_TRUSTED_PROXIES=
# Wider than a /24 or /64 only with this (never 0.0.0.0/0 or ::/0):
#BRIEVIE_TRUSTED_PROXIES_WIDE=false
# The web interface on the public address. Off: there only the app works. On: signing in
# there needs two-step verification (a VPN is still the better way).
#BRIEVIE_PUBLIC_WEB=false
