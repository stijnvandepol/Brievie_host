# Template only: the placeholders below are refused by the server. `make dev` or
# `sh deploy/init-env.sh` creates deploy/.env from this file with random secrets (and
# never overwrites an existing one).

# The database passwords are put into connection URLs: use only letters and digits
# (init-env.sh generates hex).
# PostgreSQL superuser; only used by the container to create the roles below.
POSTGRES_PASSWORD=change-me-postgres
# Schema owner: runs migrations and the test suite. CREATEDB, never superuser.
BRIEVIE_OWNER_PASSWORD=change-me-owner
# Application role: data access only (SELECT/INSERT/UPDATE/DELETE).
BRIEVIE_APP_PASSWORD=change-me-app

# Host port for PostgreSQL, bound to 127.0.0.1 only, and only for development:
# make publishes it (deploy/docker-compose.dev.yml); ./brievie only when
# BRIEVIE_PUBLISH_POSTGRES=true is set below. An installation does not need it.
POSTGRES_PORT=5432
# BRIEVIE_PUBLISH_POSTGRES=true

# Used by the backend when it runs on the host (make test, make migrate).
# The containers build their own URLs from the passwords above; only the
# one-shot migrate container gets the owner URL.
DATABASE_URL=postgres://brievie_app:change-me-app@localhost:5432/brievie
DATABASE_OWNER_URL=postgres://brievie_owner:change-me-owner@localhost:5432/brievie

# At least 50 characters; the server refuses to start with the placeholder.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
# Comma-separated https origins of the web interface, e.g. https://brievie.local
CSRF_TRUSTED_ORIGINS=

# Host ports Caddy publishes. Change them only to run a second stack next to this one;
# the port then becomes part of the address in the pairing QR code.
BRIEVIE_HTTP_PORT=80
BRIEVIE_HTTPS_PORT=443

# The name or IP address your phone uses to reach this server on the home network,
# e.g. 192.168.1.20 or brievie.local. "localhost" only works for this computer, not
# for a phone. This one value is all most installations need: ALLOWED_HOSTS and
# BRIEVIE_PUBLIC_URLS follow from it, and Caddy serves (and issues its internal
# certificate for) this name.
BRIEVIE_HOSTNAME=localhost

# --- Van buiten bereikbaar (reachable from outside the home network) --------------------
# Nothing here is needed at home. Explanation and examples per way: docs/SELFHOST.md and
# https://brievie.com/docs/installeren#van-buiten. Recommended: a VPN (Tailscale,
# WireGuard): the connection is encrypted from the phone to this server and nobody in
# between can read it.
#
# The server's own VPN name, when the VPN runs on this server itself (Tailscale on the
# NAS): its MagicDNS name, e.g. nas.tail1234.ts.net. Not needed for a VPN into the router.
# BRIEVIE_VPN_HOSTNAME=
# The public name of a Cloudflare Tunnel or your own reverse proxy, e.g.
# brievie.example.nl (only the name: no https://, no port).
# BRIEVIE_PUBLIC_HOSTNAME=
#
# Cloudflare Tunnel. Cloudflare ends the encryption on its own servers: everything that
# passes through (scanned pages, texts, the app's device token) can be read there, and
# Cloudflare's terms apply. Only the cloudflared container gets the token.
# BRIEVIE_TUNNEL_TOKEN=
# ... or, better (it then shows in no `docker inspect`), a file on this server that holds
# the token, owner uid 65532, mode 0400:
# BRIEVIE_TUNNEL_TOKEN_FILE=
# Only when you start without ./brievie (./brievie starts the tunnel itself; leave this
# out with ./brievie):
# COMPOSE_PROFILES=tunnel
#
# Your own reverse proxy (Nginx Proxy Manager, Traefik, Synology): the address(es) Brievie
# sees for it, as CIDRs separated by spaces, e.g. 192.168.1.5/32. Never Docker's own
# gateway address: then every device in your network could pick its own address.
# BRIEVIE_TRUSTED_PROXIES=
#
# The web interface (and its sign-in with a password) on the public address. Off by
# default: through the public address only the app works. Leave it off until two-step
# sign-in exists.
# BRIEVIE_PUBLIC_WEB=false

# HSTS max-age in seconds for the home and VPN names (Caddy sends it). Keep 0 with
# Caddy's private CA, so a browser can still click through its certificate warning. The
# tunnel and your own reverse proxy carry a public certificate and always get one year.
BRIEVIE_HSTS_SECONDS=0

# Largest request body in bytes, enforced by Caddy and Django alike (2.5 MiB).
BRIEVIE_MAX_BODY_BYTES=2621440
# Largest document upload in bytes (all pages of one scan together, 32 MiB).
BRIEVIE_MAX_UPLOAD_BYTES=33554432

# Encrypts the documents (it wraps each workspace's own key): 64 hexadecimal characters.
# init-env.sh generates it. Keep a copy somewhere safe: without this key the stored
# documents cannot be read, and a back-up of the data alone is useless.
BRIEVIE_MASTER_KEY=change-me-master-key

# Back-up. The read-only database role brievie_backup makes the database dump; the
# URL is only used on the host (make test).
BRIEVIE_BACKUP_DB_PASSWORD=change-me-backup
DATABASE_BACKUP_URL=postgres://brievie_backup:change-me-backup@localhost:5432/brievie
# Encrypts the back-ups. Added by ./brievie: derived from BRIEVIE_MASTER_KEY inside the
# container, so the master key alone opens them. For a separate password set your own
# here before `./brievie backup --init --separate-password` (or let that command make
# one); it then writes a new recovery sheet with both secrets: print it at once.
# BRIEVIE_BACKUP_PASSWORD=
# Where the back-ups go (one server per place; never inside Brievie's own data): a folder
# (an external disk or a mounted share) ...
# BRIEVIE_BACKUP_DIR=
# ... or a repository in restic's notation, without credentials in it
# (rest:https://host:8000/brievie or s3:https://host/bucket/brievie).
# BRIEVIE_BACKUP_REPOSITORY=
# BRIEVIE_BACKUP_S3_ACCESS_KEY_ID=
# BRIEVIE_BACKUP_S3_SECRET_ACCESS_KEY=
# BRIEVIE_BACKUP_REST_USERNAME=
# BRIEVIE_BACKUP_REST_PASSWORD=
# Keep these credentials off this machine too: they are not on the recovery sheet.
# true when the destination only accepts new data (an append-only REST server).
# BRIEVIE_BACKUP_APPEND_ONLY=false

# How many days the audit log keeps its rows ("who did what"); at least 90.
# BRIEVIE_AUDIT_RETENTION_DAYS=365

# How long a web session may sit unused, and the longest it lives whatever happens; after
# that somebody signs in again. Whole days, at least 1; the first may not exceed the second.
# BRIEVIE_SESSION_IDLE_DAYS=14
# BRIEVIE_SESSION_MAX_DAYS=90

# Whether workspaces may let the AI put letters under persons and labels, and confirm
# them, by itself (the autopilot). Set to false to forbid it on this server.
# BRIEVIE_AI_AUTOPILOT_ALLOWED=true

# Installation code for the first setup. Leave empty: the api container then prints a
# generated code once in its log ("Installatiecode: ..."). Or set your own value of at
# least 16 characters.
BRIEVIE_SETUP_TOKEN=

# Optional overrides; leave them out unless you know you need them. By default the
# server derives both from BRIEVIE_HOSTNAME, BRIEVIE_VPN_HOSTNAME and
# BRIEVIE_PUBLIC_HOSTNAME:
#   ALLOWED_HOSTS=<each of those names>
#   BRIEVIE_PUBLIC_URLS=https://<BRIEVIE_HOSTNAME>:<BRIEVIE_HTTPS_PORT>,
#     https://<BRIEVIE_VPN_HOSTNAME>:<BRIEVIE_HTTPS_PORT>,https://<BRIEVIE_PUBLIC_HOSTNAME>
# BRIEVIE_PUBLIC_URLS are the addresses the iOS app uses (pairing QR code): comma-
# separated, each https://, the local address first, e.g. a second address for use
# away from home. Every host in it must also be in ALLOWED_HOSTS (comma-separated).
# ALLOWED_HOSTS=192.168.1.20,brievie.example.nl
# BRIEVIE_PUBLIC_URLS=https://192.168.1.20,https://brievie.example.nl

# Secure cookies are on by default. Only for local development over plain http:
# SESSION_COOKIE_SECURE=false
# CSRF_COOKIE_SECURE=false
