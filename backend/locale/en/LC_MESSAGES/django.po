#: apps/updates/release.py
msgid "Er is niets veranderd."
msgstr "Nothing has changed."

#: apps/updates/release.py
msgid "Deze installatie is van vóór de versienummers. Werk één keer met de hand bij: git fetch --tags, git checkout v{target}, ./brievie start. Daarna werkt ./brievie update."
msgstr "This installation is from before the version numbers. Update by hand once: git fetch --tags, git checkout v{target}, ./brievie start. After that ./brievie update works."

#: apps/updates/release.py
msgid "Een oudere versie installeren kan niet. Terug ga je met een herstel van de back-up van vóór het bijwerken."
msgstr "Installing an older version is not possible. You go back by restoring the backup from before the update."

#: apps/updates/release.py
msgid "Versie {target} bestaat niet: er is geen tag v{target} met een release.json."
msgstr "Version {target} does not exist: there is no tag v{target} with a release.json."

#: apps/updates/release.py
msgid "De gegevens van versie {target} (deploy/release.json) kloppen niet."
msgstr "The details of version {target} (deploy/release.json) are not correct."

#: apps/updates/release.py
msgid "De tag v{target} hoort niet bij versie {target}: zijn release.json noemt een andere versie."
msgstr "The tag v{target} does not belong to version {target}: its release.json names another version."

#: apps/updates/release.py
msgid "Versie {target} moet op een nieuwere manier worden bijgewerkt dan deze versie kent. Lees \"Voor je bijwerkt\" in CHANGELOG.md."
msgstr "Version {target} must be updated in a newer way than this version knows. Read \"Before you update\" in CHANGELOG.md."

#: apps/updates/release.py
msgid "Versie {target} gebruikt een andere hoofdversie van PostgreSQL dan deze server ({postgres_major}). Die overstap kan ./brievie update nog niet maken. Lees \"Voor je bijwerkt\" in CHANGELOG.md."
msgstr "Version {target} uses a different major version of PostgreSQL than this server ({postgres_major}). ./brievie update cannot make that switch yet. Read \"Before you update\" in CHANGELOG.md."

#: apps/updates/release.py
msgid "Van versie {installed} kun je niet in één keer naar {target}. Werk eerst bij naar {go_first}: ./brievie update {go_first}"
msgstr "From version {installed} you cannot go to {target} in one step. First update to {go_first}: ./brievie update {go_first}"

#: apps/updates/release.py
msgid "Van versie {installed} is er geen weg naar {target} met ./brievie update. Lees \"Voor je bijwerkt\" in CHANGELOG.md."
msgstr "From version {installed} there is no way to {target} with ./brievie update. Read \"Before you update\" in CHANGELOG.md."

