{
  "name": "brievie-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts",
    "extract": "lingui extract --clean"
  },
  "dependencies": {
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "^2.6.7",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
